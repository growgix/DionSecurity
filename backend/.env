APP_ENV=development
APP_DEBUG=true
PORT=8000

# Database Engine Selection: 'sqlite' (zero-config) or 'pgsql' (PostgreSQL)
DB_CONNECTION=sqlite

# PostgreSQL Configuration (used when DB_CONNECTION=pgsql)
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=dion_security
DB_USERNAME=postgres
DB_PASSWORD=postgres

