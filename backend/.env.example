APP_ENV=production
APP_DEBUG=false
PORT=8000

# Database Engine Selection: 'mysql' (MySQL 8.0)
DB_CONNECTION=mysql

# MySQL Configuration
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=dion_security
DB_USERNAME=your_db_user
DB_PASSWORD=your_secure_db_password

# Security & CORS Configuration (Comma-separated allowed origins)
CORS_ALLOWED_ORIGINS=https://app.dionsecurity.internal,http://localhost:3000
